# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (the blank public template is the only exception)
.env*
!.env.example

# per-deployment OpenAI Sites configuration
/.openai/hosting.json

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# local databases and exports can contain household data and credentials
*.sqlite
*.sqlite3
*.db
*.sql.gz

# native macOS build products
/mac/GridlineMenu/.build/

# native Apple derived build products
/apple/GridlineEnergy/.derived/
**/xcuserdata/
